{
  "name": "nicotine-hub",
  "version": "0.27.0",
  "private": false,
  "license": "GPL-3.0-or-later",
  "description": "Browser-first Soulseek client — Nicotine Hub.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.mjs",
    "dev:bridge": "bun run --cwd apps/bridge dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/bridge build && bun run --cwd apps/web build",
    "test": "bun run --cwd apps/bridge test",
    "typecheck": "bun run --cwd apps/bridge typecheck && bun run --cwd apps/web typecheck"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "concurrently": "^9.1.2",
    "playwright": "1.62.1"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "bun@1.4.0"
}
