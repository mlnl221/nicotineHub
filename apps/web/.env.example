# Optional override for the bridge WebSocket URL, used by the web app at
# build time and overridable at runtime via localStorage key "nicotineHub.bridgeUrl".
# Default (unset): same-origin /ws on the web origin, proxied to the bridge
# by proxy-server.js — no published bridge port needed.
# Set this only for direct remote-bridge access (e.g. Vercel web + home bridge).
# Examples:
#   NEXT_PUBLIC_BRIDGE_URL=ws://localhost:8787/ws
#   NEXT_PUBLIC_BRIDGE_URL=wss://example.com:8787/ws

# Worker service (scrape/spectrum/tag) — build-time default, runtime override
# via localStorage key "nicotineHub.workerUrl". Auth via localStorage
# "nicotineHub.workerToken" (or NEXT_PUBLIC_WORKER_TOKEN).
# Default (unset): same-origin /api/worker on the web origin, proxied to the
# worker — no published worker port needed.
#   NEXT_PUBLIC_WORKER_URL=http://localhost:8789
#   NEXT_PUBLIC_WORKER_TOKEN=

# Server-side proxy targets (compose DNS in Docker, localhost in bare dev).
# The web server fetches these; the browser never calls them directly.
#   BRIDGE_INTERNAL_URL=http://bridge:8787
#   WORKER_INTERNAL_URL=http://worker:8789
#   BRIDGE_TOKEN=changeme (fallback when the browser sends no Bearer token)
#   WORKER_TOKEN=changeme (same for the worker proxy)
