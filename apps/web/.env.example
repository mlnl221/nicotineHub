# Optional override for the bridge WebSocket URL, used by the web app at
# build time and overridable at runtime via localStorage key "nicotineHub.bridgeUrl".
# Default (unset): same-origin /ws on the web origin, proxied to the bridge
# by proxy-server.js — no published bridge port needed.
# Set this only for direct remote-bridge access (e.g. Vercel web + home bridge).
# Examples:
#   NEXT_PUBLIC_BRIDGE_URL=ws://localhost:8787/ws
#   NEXT_PUBLIC_BRIDGE_URL=wss://example.com:8787/ws

# Worker service (scrape/spectrum/tag) — build-time default, runtime override
# via localStorage key "nicotineHub.workerUrl". Auth via localStorage
# "nicotineHub.workerToken" (or NEXT_PUBLIC_WORKER_TOKEN).
# Default (unset): same-origin /api/worker on the web origin, proxied to the
# worker — no published worker port needed.
#   NEXT_PUBLIC_WORKER_URL=http://localhost:8789
#   NEXT_PUBLIC_WORKER_TOKEN=

# Server-side proxy targets (compose DNS in Docker, localhost in bare dev).
# The web server fetches these; the browser never calls them directly.
#   BRIDGE_INTERNAL_URL=http://bridge:8787
#   WORKER_INTERNAL_URL=http://worker:8789
#   BRIDGE_TOKEN=changeme (fallback when the browser sends no Bearer token)
#   WORKER_TOKEN=changeme (same for the worker proxy)

# Browser token overrides (build-time; runtime localStorage keys win:
# "nicotineHub.bridgeToken" / "nicotineHub.workerToken"). Must match
# BRIDGE_TOKEN / WORKER_TOKEN when those are set.
#   NEXT_PUBLIC_BRIDGE_TOKEN=
#   NEXT_PUBLIC_WORKER_TOKEN=

# Demo mode (Vercel frontend-only): mocks bridge + worker with fixtures.
#   NEXT_PUBLIC_DEMO=true

# Web server ports (compose entry is proxy-server.js: outer PORT forwards
# HTTP to inner Next on INNER_PORT and pipes /ws to the bridge).
#   PORT=3000
#   HOSTNAME=0.0.0.0
#   INNER_PORT=3101

# Build version (Docker ARGs TAG/BUILD_TAG/COMMIT_SHA/BUILD_DATE feed these).
#   NEXT_PUBLIC_BUILD_TAG=v0.25.0
#   NEXT_PUBLIC_APP_VERSION=v0.25.0 (fallback when BUILD_TAG unset)
#   NEXT_PUBLIC_COMMIT_SHA=abc1234
#   NEXT_PUBLIC_BUILD_DATE=2026-09-10

# Worker media-scan webhook (Settings → Worker writes CONFIG_DIR/worker.json
# instead; env wins when both set).
#   MEDIA_SCAN_URL=https://example.com/hook
#   MEDIA_SCAN_TOKEN=changeme

# CORS lock-down (bridge + worker; open when unset).
#   ALLOWED_ORIGINS=https://hub.example.com,http://nas:3000

# Dirs (compose volumes; dev falls back when unwritable).
#   CONFIG_DIR=/config (worker.json 0600, shares/downloads/plugins/statistics.json)
#   DATA_DIR=/data (downloads/, incomplete/, uploads/)
#   SPECTRUM_DIR=/tmp/spectrals (ephemeral worker PNG cache)
